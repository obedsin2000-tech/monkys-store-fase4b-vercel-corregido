# Copia las variables en Vercel -> Project -> Settings -> Environment Variables.
# NO escribas datos reales en este archivo y NO lo subas con credenciales.
# Production: los dos primeros valores provienen del proyecto Supabase que ya usas.
NEXT_PUBLIC_SUPABASE_URL=https://TU_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_CLAVE_PUBLICA_ANON
# Configura esta URL DESPUES del primer despliegue y vuelve a desplegar.
# Debe comenzar con https:// y no terminar con /auth/callback.
NEXT_PUBLIC_SITE_URL=https://TU_DOMINIO.vercel.app
